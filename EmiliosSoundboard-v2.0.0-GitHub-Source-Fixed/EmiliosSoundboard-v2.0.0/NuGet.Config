<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Keep builds reproducible on machines that have a restrictive global NuGet
       packageSourceMapping (some Visual Studio installs map only their own feed). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
